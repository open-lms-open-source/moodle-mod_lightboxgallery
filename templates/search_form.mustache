{{!
    @template mod_lightboxgallery/search_form

    Search the captions and tags of one gallery, or of every gallery in the course.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * action - The search page's URL.
    * courseid - The course.
    * search - What was searched for.
    * galleries - The galleries to choose from: id, name (already formatted) and selected.

    Example context (json):
    {
        "action": "https://example.com/mod/lightboxgallery/search.php",
        "courseid": 2,
        "search": "beach",
        "galleries": [{"id": 1, "name": "The zoo", "selected": true}, {"id": 2, "name": "Sports day", "selected": false}]
    }
}}
<form action="{{action}}" method="get" class="mod-lightboxgallery-search-form d-flex flex-wrap align-items-end gap-2 mb-3" role="search">
    <input type="hidden" name="id" value="{{courseid}}">
    <div>
        <label for="{{uniqid}}-gallery" class="form-label">{{#str}}modulenameshort, mod_lightboxgallery{{/str}}</label>
        <select name="gallery" id="{{uniqid}}-gallery" class="form-select">
            <option value="0">{{#str}}allgalleries, mod_lightboxgallery{{/str}}</option>
            {{#galleries}}
                <option value="{{id}}"{{#selected}} selected{{/selected}}>{{{name}}}</option>
            {{/galleries}}
        </select>
    </div>
    <div>
        <label for="{{uniqid}}-search" class="form-label">{{#str}}search{{/str}}</label>
        <input type="search" name="search" id="{{uniqid}}-search" class="form-control" value="{{search}}">
    </div>
    <button type="submit" class="btn btn-primary">{{#str}}search{{/str}}</button>
</form>
