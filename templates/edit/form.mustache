{{!
    @template mod_lightboxgallery/edit/form

    The form every image editing tool posts back to imageedit.php. Tools fill in the fields block.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * action, sesskey, cmid, image, tab, page - Where the form posts, and which image and tool it's for.

    Example context (json):
    {
        "action": "https://example.com/mod/lightboxgallery/imageedit.php",
        "sesskey": "abc123",
        "cmid": 5,
        "image": "bus.png",
        "tab": "caption",
        "page": 0
    }
}}
<form action="{{action}}" method="post" class="mod-lightboxgallery-edit-form">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    <input type="hidden" name="id" value="{{cmid}}">
    <input type="hidden" name="image" value="{{image}}">
    <input type="hidden" name="tab" value="{{tab}}">
    <input type="hidden" name="page" value="{{page}}">
    <input type="hidden" name="process" value="1">
    {{$fields}}{{/fields}}
</form>
