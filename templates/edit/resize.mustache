{{!
    @template mod_lightboxgallery/edit/resize

    Resize an image to one of the preset sizes, or scale it.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * action, sesskey, cmid, image, tab, page - For mod_lightboxgallery/edit/form.
    * currentsize - The image's size now.
    * sizes, scales - The options offered: value and label.
    * resizelabel, scalelabel - The two buttons, which tell the tool which was chosen.

    Example context (json):
    {
        "action": "https://example.com/mod/lightboxgallery/imageedit.php",
        "sesskey": "abc123",
        "cmid": 5,
        "image": "bus.png",
        "tab": "resize",
        "page": 0,
        "currentsize": "Current size: 800x600",
        "sizes": [{"value": 1, "label": "1280x1024"}],
        "scales": [{"value": 50, "label": "50%"}],
        "resizelabel": "Resize",
        "scalelabel": "Scale"
    }
}}
{{< mod_lightboxgallery/edit/form }}
    {{$fields}}
        <p>{{currentsize}}</p>
        <div class="input-group mb-3">
            <label for="{{uniqid}}-size" class="visually-hidden">{{resizelabel}}</label>
            <select name="size" id="{{uniqid}}-size" class="form-select">
                {{#sizes}}<option value="{{value}}">{{label}}</option>{{/sizes}}
            </select>
            <button type="submit" class="btn btn-secondary" name="button" value="{{resizelabel}}">{{resizelabel}}</button>
        </div>
        <div class="input-group">
            <label for="{{uniqid}}-scale" class="visually-hidden">{{scalelabel}}</label>
            <select name="scale" id="{{uniqid}}-scale" class="form-select">
                {{#scales}}<option value="{{value}}">{{label}}</option>{{/scales}}
            </select>
            <button type="submit" class="btn btn-secondary" name="button" value="{{scalelabel}}">{{scalelabel}}</button>
        </div>
    {{/fields}}
{{/ mod_lightboxgallery/edit/form }}
