{{!
    @template mod_lightboxgallery/edit/rotate

    Rotate an image.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * action, sesskey, cmid, image, tab, page - For mod_lightboxgallery/edit/form.
    * angles - The angles offered: value and label.

    Example context (json):
    {
        "action": "https://example.com/mod/lightboxgallery/imageedit.php",
        "sesskey": "abc123",
        "cmid": 5,
        "image": "bus.png",
        "tab": "rotate",
        "page": 0,
        "angles": [{"value": -90, "label": "-90°", "first": true}, {"value": 90, "label": "90°", "first": false}]
    }
}}
{{< mod_lightboxgallery/edit/form }}
    {{$fields}}
        <fieldset class="mb-3">
            <legend class="fs-6">{{#str}}selectrotation, mod_lightboxgallery{{/str}}</legend>
            {{#angles}}
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="angle" id="{{uniqid}}-angle{{value}}" value="{{value}}"{{#first}} required{{/first}}>
                    <label class="form-check-label" for="{{uniqid}}-angle{{value}}">{{label}}</label>
                </div>
            {{/angles}}
        </fieldset>
        <button type="submit" class="btn btn-secondary">{{#str}}edit_rotate, mod_lightboxgallery{{/str}}</button>
    {{/fields}}
{{/ mod_lightboxgallery/edit/form }}
