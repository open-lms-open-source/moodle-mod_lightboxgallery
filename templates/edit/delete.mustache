{{!
    @template mod_lightboxgallery/edit/delete

    Confirm deleting an image.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * action, sesskey, cmid, image, tab, page - For mod_lightboxgallery/edit/form.
    * message - The question to ask.

    Example context (json):
    {
        "action": "https://example.com/mod/lightboxgallery/imageedit.php",
        "sesskey": "abc123",
        "cmid": 5,
        "image": "bus.png",
        "tab": "delete",
        "page": 0,
        "message": "Delete bus.png ?"
    }
}}
{{< mod_lightboxgallery/edit/form }}
    {{$fields}}
        <p>{{message}}</p>
        <button type="submit" class="btn btn-secondary">{{#str}}yes{{/str}}</button>
    {{/fields}}
{{/ mod_lightboxgallery/edit/form }}
