{{!
    @template mod_lightboxgallery/edit/thumbnail

    Use an image as the gallery's index image, or move which part of it the thumbnail shows.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * action, sesskey, cmid, image, tab, page - For mod_lightboxgallery/edit/form.
    * helpicon - HTML for the help icon about the index image.
    * directions - The ways the thumbnail can move: value and label.

    Example context (json):
    {
        "action": "https://example.com/mod/lightboxgallery/imageedit.php",
        "sesskey": "abc123",
        "cmid": 5,
        "image": "bus.png",
        "tab": "thumbnail",
        "page": 0,
        "helpicon": "",
        "directions": [{"value": 3, "label": "Left"}, {"value": 4, "label": "Right"}]
    }
}}
{{< mod_lightboxgallery/edit/form }}
    {{$fields}}
        <div class="mb-4">
            <button type="submit" class="btn btn-secondary" name="index" value="1">{{#str}}setasindex, mod_lightboxgallery{{/str}}</button>
            {{{helpicon}}}
        </div>
    {{/fields}}
{{/ mod_lightboxgallery/edit/form }}
{{< mod_lightboxgallery/edit/form }}
    {{$fields}}
        <fieldset class="mb-3">
            <legend class="fs-6">{{#str}}selectthumbpos, mod_lightboxgallery{{/str}}</legend>
            {{#directions}}
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="move" id="{{uniqid}}-move{{value}}" value="{{value}}">
                    <label class="form-check-label" for="{{uniqid}}-move{{value}}">{{label}}</label>
                </div>
            {{/directions}}
        </fieldset>
        <div class="d-flex flex-wrap align-items-center mb-3">
            <label for="{{uniqid}}-offset" class="me-2">{{#str}}thumbnailoffset, mod_lightboxgallery{{/str}}</label>
            <input type="number" class="form-control w-auto" name="offset" id="{{uniqid}}-offset" value="20" min="0" step="1">
        </div>
        <button type="submit" class="btn btn-secondary">{{#str}}move{{/str}}</button>
        <button type="submit" class="btn btn-secondary" name="reset" value="1">{{#str}}reset{{/str}}</button>
    {{/fields}}
{{/ mod_lightboxgallery/edit/form }}
