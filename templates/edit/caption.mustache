{{!
    @template mod_lightboxgallery/edit/caption

    Edit an image's caption.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * action, sesskey, cmid, image, tab, page - For mod_lightboxgallery/edit/form.
    * captionhtml - The caption, already HTML-escaped so it comes back exactly as stored.

    Example context (json):
    {
        "action": "https://example.com/mod/lightboxgallery/imageedit.php",
        "sesskey": "abc123",
        "cmid": 5,
        "image": "bus.png",
        "tab": "caption",
        "page": 0,
        "captionhtml": "The school bus"
    }
}}
{{< mod_lightboxgallery/edit/form }}
    {{$fields}}
        <label for="{{uniqid}}-caption" class="visually-hidden">{{#str}}edit_caption, mod_lightboxgallery{{/str}}</label>
        {{! Escaped with htmlspecialchars, not Mustache's s(), which leaves numeric entities alone. }}
        <textarea name="caption" id="{{uniqid}}-caption" class="form-control mb-3" cols="24" rows="4">{{{captionhtml}}}</textarea>
        <button type="submit" class="btn btn-secondary">{{#str}}update{{/str}}</button>
    {{/fields}}
{{/ mod_lightboxgallery/edit/form }}
