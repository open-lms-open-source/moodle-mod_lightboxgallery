{{!
    @template mod_lightboxgallery/edit/flip

    Flip an image vertically or horizontally.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * action, sesskey, cmid, image, tab, page - For mod_lightboxgallery/edit/form.
    * vertical, horizontal - The form values for each direction.

    Example context (json):
    {
        "action": "https://example.com/mod/lightboxgallery/imageedit.php",
        "sesskey": "abc123",
        "cmid": 5,
        "image": "bus.png",
        "tab": "flip",
        "page": 0,
        "vertical": 1,
        "horizontal": 2
    }
}}
{{< mod_lightboxgallery/edit/form }}
    {{$fields}}
        <fieldset class="mb-3">
            <legend class="fs-6">{{#str}}selectflipmode, mod_lightboxgallery{{/str}}</legend>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="mode" id="{{uniqid}}-vertical" value="{{vertical}}" required>
                <label class="form-check-label" for="{{uniqid}}-vertical">{{#str}}flipvertical, mod_lightboxgallery{{/str}}</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="mode" id="{{uniqid}}-horizontal" value="{{horizontal}}">
                <label class="form-check-label" for="{{uniqid}}-horizontal">{{#str}}fliphorizontal, mod_lightboxgallery{{/str}}</label>
            </div>
        </fieldset>
        <button type="submit" class="btn btn-secondary">{{#str}}edit_flip, mod_lightboxgallery{{/str}}</button>
    {{/fields}}
{{/ mod_lightboxgallery/edit/form }}
