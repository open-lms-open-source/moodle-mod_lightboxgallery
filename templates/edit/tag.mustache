{{!
    @template mod_lightboxgallery/edit/tag

    Add tags to an image, import tags from the gallery's images, and remove tags.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * action, sesskey, cmid, image, tab, page - For mod_lightboxgallery/edit/form.
    * importbutton - HTML for the button that imports tags from every image.
    * hastags - Whether the image has any tags to remove.
    * tags - The image's tags: id and description.

    Example context (json):
    {
        "action": "https://example.com/mod/lightboxgallery/imageedit.php",
        "sesskey": "abc123",
        "cmid": 5,
        "image": "bus.png",
        "tab": "tag",
        "page": 0,
        "importbutton": "<button class=\"btn btn-secondary\">Import tags</button>",
        "hastags": true,
        "tags": [{"id": 3, "description": "beach"}]
    }
}}
{{< mod_lightboxgallery/edit/form }}
    {{$fields}}
        <div class="input-group mb-3">
            <label for="{{uniqid}}-tag" class="visually-hidden">{{#str}}edit_tag, mod_lightboxgallery{{/str}}</label>
            <input type="text" class="form-control" name="tag" id="{{uniqid}}-tag">
            <button type="submit" class="btn btn-secondary">{{#str}}add{{/str}}</button>
        </div>
    {{/fields}}
{{/ mod_lightboxgallery/edit/form }}
<div class="mb-3">{{{importbutton}}}</div>
{{#hastags}}
    {{< mod_lightboxgallery/edit/form }}
        {{$fields}}
            <input type="hidden" name="delete" value="1">
            <fieldset class="mb-3">
                <legend class="fs-6">{{#str}}tagscurrent, mod_lightboxgallery{{/str}}</legend>
                {{#tags}}
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="deletetags[]" id="{{uniqid}}-tag{{id}}" value="{{id}}">
                        <label class="form-check-label" for="{{uniqid}}-tag{{id}}">{{description}}</label>
                    </div>
                {{/tags}}
            </fieldset>
            <button type="submit" class="btn btn-secondary">{{#str}}remove{{/str}}</button>
        {{/fields}}
    {{/ mod_lightboxgallery/edit/form }}
{{/hastags}}
