{{!
    @template mod_lightboxgallery/index

    The course's list of galleries, with each one's picture, counts, description and feed.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * usesections - Whether the course format has sections, and so a section column.
    * sectionheading - What the course format calls a section.
    * galleries - The galleries:
      * newsection - Whether this gallery starts a new section.
      * sectionname - The section's name.
      * imageurl - The gallery's picture.
      * viewurl - The gallery.
      * name - The gallery's name, already formatted.
      * visible - Whether students can see it; hidden ones are dimmed.
      * counts - How many images, and comments where those can be seen.
      * intro - The gallery's description, already formatted.
      * rsslink - HTML for its feed's link, or null without a feed.

    Example context (json):
    {
        "usesections": true,
        "sectionheading": "Section",
        "galleries": [{
            "newsection": true,
            "sectionname": "Field trips",
            "imageurl": "https://example.com/pluginfile.php/1/mod_lightboxgallery/gallery_index/0/index.png",
            "viewurl": "https://example.com/mod/lightboxgallery/view.php?id=5",
            "name": "The zoo",
            "visible": true,
            "counts": "12 images 3 comments",
            "intro": "<p>Photos from our trip to the zoo.</p>",
            "rsslink": null
        }]
    }
}}
<table class="generaltable mod-lightboxgallery-index">
    <thead>
        <tr>
            {{#usesections}}<th scope="col">{{sectionheading}}</th>{{/usesections}}
            <th scope="col"><span class="visually-hidden">{{#str}}indeximage, mod_lightboxgallery{{/str}}</span></th>
            <th scope="col">{{#str}}modulenameshort, mod_lightboxgallery{{/str}}</th>
            <th scope="col">{{#str}}description{{/str}}</th>
            <th scope="col">{{#str}}rss{{/str}}</th>
        </tr>
    </thead>
    <tbody>
        {{#galleries}}
            <tr>
                {{#usesections}}<td>{{#newsection}}{{sectionname}}{{/newsection}}</td>{{/usesections}}
                <td><img src="{{imageurl}}" alt=""></td>
                <td>
                    <a href="{{viewurl}}"{{^visible}} class="dimmed"{{/visible}}>{{{name}}}</a>
                    <div class="text-muted">{{counts}}</div>
                </td>
                <td>{{{intro}}}</td>
                <td>{{#rsslink}}{{{.}}}{{/rsslink}}{{^rsslink}}{{#str}}norssfeedavailable, mod_lightboxgallery{{/str}}{{/rsslink}}</td>
            </tr>
        {{/galleries}}
    </tbody>
</table>
